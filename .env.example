# UrbanTwin-Toolbox instance settings. Images and stack layout are in compose.yml.
#
# This is a committed template, not runtime configuration. When initializing a new
# instance, copy it to .env and adjust values there. Use .env for all runtime commands.
# .env is ignored by git; do not put instance-specific values in this template.

# Browser-based PostgreSQL administration. Start it with compose.yml.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=utt
PGADMIN_PORT=5050

# PostgreSQL settings used by UTTDB.
UTTDB_POSTGRES_DB=uttdb
UTTDB_POSTGRES_USER=uttadmin
UTTDB_POSTGRES_PASSWORD=utt
UTTDB_POSTGRES_PORT=5432

# 3DCityDB schema setup.
# SRID is required by the 3DCityDB image. 25833 is ETRS89 / UTM zone 33N.
SRID=25833
HEIGHT_EPSG=25833
SRS_NAME=urn:ogc:def:crs:EPSG::25833
